---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import Video from '../../components/Video.astro';
import { getProjects, statuses, type Project } from '../../lib/projects';
import { categoryLabel } from '../../data/site';
export async function getStaticPaths() {
  return (await getProjects()).map((project) => ({
    params: { id: project.id },
    props: { project },
  }));
}
interface Props {
  project: Project;
}
const { project } = Astro.props;
const { data } = project;
const { Content } = await render(project);
const related = (await getProjects())
  .filter(
    (p) =>
      p.id !== project.id &&
      p.data.categories.some((c) => data.categories.includes(c)),
  )
  .slice(0, 2);
---

<Base
  title={data.title}
  description={data.summary}
  image={data.cover?.src}
  noindex={data.draft}
>
  <article class="shell project-page">
    {data.draft && (
      <p class="draft-banner">
        Draft preview · This project is excluded from production builds.
      </p>
    )}
    <a class="back-link" href="/work/">
      ← All work
    </a>
    <header class="project-header">
      <p class="eyebrow">
        {data.categories.map(categoryLabel).join(' / ')}
        <span class="separator">·</span>
        {statuses[data.status]}
      </p>
      <h1>{data.title}</h1>
      <p class="project-deck">{data.summary}</p>
      <dl class="project-facts">
        <div>
          <dt>My contribution</dt>
          <dd>{data.role}</dd>
        </div>
        {data.year && (
          <div>
            <dt>Year</dt>
            <dd>{data.year}</dd>
          </div>
        )}
        {data.tools.length > 0 && (
          <div>
            <dt>Tools</dt>
            <dd>{data.tools.join(', ')}</dd>
          </div>
        )}
        {data.stage && (
          <div>
            <dt>Current stage</dt>
            <dd>{data.stage}</dd>
          </div>
        )}
      </dl>
    </header>
    {data.videos.length > 0 ? (
      <section aria-label="Project films" class="project-videos">
        {data.videos.map((video, index) => (
          <div>
            {data.videos.length > 1 && (
              <h2 class="video-title">{video.title}</h2>
            )}
            <Video
              id={video.id}
              title={video.title}
              poster={index === 0 ? data.cover?.src : undefined}
            />
          </div>
        ))}
      </section>
    ) : (
      data.cover && (
        <figure
          class:list={[
            'project-cover',
            { contain: data.coverFit === 'contain' },
          ]}
        >
          <img
            src={data.cover.src}
            alt={data.cover.alt}
            width="1600"
            height="900"
            fetchpriority="high"
          />
          {data.cover.caption && <figcaption>{data.cover.caption}</figcaption>}
        </figure>
      )
    )}
    <div class="project-body">
      <div class="prose">
        <Content />
      </div>
      <aside class="project-aside">
        {data.links.length > 0 && (
          <div>
            <h2>Explore the project</h2>
            {data.links.map((link) => (
              <a
                class="aside-link"
                href={link.href}
                target={link.href.startsWith('http') ? '_blank' : undefined}
                rel={
                  link.href.startsWith('http')
                    ? 'noopener noreferrer'
                    : undefined
                }
              >
                {link.label} ↗
              </a>
            ))}
          </div>
        )}
        <div>
          <h2>Explore this discipline</h2>
          {data.categories.map((category) => (
            <a class="aside-link" href={`/work/?category=${category}`}>
              {categoryLabel(category)} →
            </a>
          ))}
        </div>
      </aside>
    </div>
    {data.gallery.length > 0 && (
      <section class="project-gallery" aria-label="Project images">
        {data.gallery.map((picture) => (
          <figure>
            <a href={picture.src} target="_blank" rel="noopener noreferrer">
              <img
                src={picture.src}
                alt={picture.alt}
                width="1200"
                height="800"
                loading="lazy"
                decoding="async"
              />
            </a>
            {picture.caption && <figcaption>{picture.caption}</figcaption>}
          </figure>
        ))}
      </section>
    )}
    {data.updates.length > 0 && (
      <section class="project-updates">
        <p class="eyebrow">From the workbench</p>
        <h2>Production notes</h2>
        {[...data.updates]
          .sort((a, b) => b.date.localeCompare(a.date))
          .map((update) => (
            <div>
              <time datetime={update.date}>
                {new Date(update.date + 'T12:00:00Z').toLocaleDateString(
                  'en-GB',
                  {
                    day: 'numeric',
                    month: 'long',
                    year: 'numeric',
                    timeZone: 'UTC',
                  },
                )}
              </time>
              <p>{update.text}</p>
            </div>
          ))}
      </section>
    )}
  </article>
  {related.length > 0 && (
    <section class="section shell related-work">
      <div class="section-heading">
        <h2>Keep exploring.</h2>
        <a class="text-link" href="/work/">
          All projects ↗
        </a>
      </div>
      <div class="project-grid">
        {related.map((project) => (
          <ProjectCard project={project} compact />
        ))}
      </div>
    </section>
  )}
</Base>
