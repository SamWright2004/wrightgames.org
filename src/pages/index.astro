---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { categories } from '../data/site';
import { getProjects, isInProgress } from '../lib/projects';
const projects = await getProjects();
const selected = projects.filter((p) => p.data.featured && !isInProgress(p));
const developing = projects.filter(isInProgress).slice(0, 2);
---

<Base>
  <section class="hero shell">
    <div class="hero-copy">
      <p class="eyebrow">
        <span class="little-cross" aria-hidden="true">
          ✳
        </span>{' '}
        Filmmaker & digital creator · Leeds, UK
      </p>
      <h1>
        Stories.
        <br />
        Worlds.
        <br />
        <em>Things that work.</em>
      </h1>
      <p class="hero-description">
        I’m Sam. I make films, build digital worlds and turn ideas into things
        you can use. Creative thinking, with a technical streak.
      </p>
      <div class="hero-actions">
        <a class="button button-primary" href="/work/">
          Explore my work <span aria-hidden="true">↗</span>
        </a>
        <a class="text-link" href="/about/">
          A little about me <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
    <a class="hero-art" href="/work/black-hole/">
      <img
        src="/images/BlackHole2.png"
        alt="Sam’s digital black-hole artwork: a luminous violet accretion disc against a field of stars"
        width="1920"
        height="1080"
        fetchpriority="high"
      />
      <div class="art-corner" aria-hidden="true">
        SW / 01
      </div>
      <div class="hero-art-caption">
        <span>
          <small>From the portfolio</small>Black hole{' '}
          <span class="muted">/ Digital artwork</span>
        </span>
        <span class="circle-arrow" aria-hidden="true">
          ↗
        </span>
      </div>
    </a>
  </section>
  <div class="discipline-strip shell" aria-label="Explore by discipline">
    {categories.map((category, index) => (
      <a href={`/work/?category=${category.id}`}>
        <span class="index-number">0{index + 1}</span>
        {category.label}
        <span aria-hidden="true">↗</span>
      </a>
    ))}
  </div>
  <section class="section shell" aria-labelledby="selected-heading">
    <div class="section-heading">
      <div>
        <p class="eyebrow">01 / Selected projects</p>
        <h2 id="selected-heading">
          A curious mind.
          <br />A range of ways to make.
        </h2>
      </div>
      <a class="text-link" href="/work/">
        View all projects <span aria-hidden="true">↗</span>
      </a>
    </div>
    <div class="project-grid selected-grid">
      {selected.map((project, index) => (
        <ProjectCard project={project} index={index} />
      ))}
    </div>
  </section>
  <section class="development-section" aria-labelledby="development-heading">
    <div class="shell">
      <div class="section-heading">
        <div>
          <p class="eyebrow">
            <span class="status-dot"></span> 02 / On the workbench
          </p>
          <h2 id="development-heading">
            The next chapter
            <br />
            is taking shape.
          </h2>
        </div>
        <div class="section-aside">
          <p>
            Longer stories, bigger worlds. A look inside the projects I’m
            developing.
          </p>
          <a class="text-link" href="/development/">
            Explore work in progress ↗
          </a>
        </div>
      </div>
      <div class="project-grid">
        {developing.map((project) => (
          <ProjectCard project={project} compact />
        ))}
      </div>
    </div>
  </section>
  <section class="section shell about-teaser">
    <div>
      <p class="eyebrow">03 / Behind the work</p>
      <h2>
        Part storyteller.
        <br />
        Part problem solver.
      </h2>
    </div>
    <div>
      <p class="large-copy">
        I like the point where a creative idea becomes a practical challenge.
      </p>
      <p>
        That might mean finding the rhythm of a scene, building an atmosphere in
        3D or figuring out how an app should feel to use. My work moves between
        those disciplines because each gives me another way to make an idea
        happen.
      </p>
      <a class="text-link" href="/about/">
        More about me <span aria-hidden="true">↗</span>
      </a>
    </div>
  </section>
</Base>
