---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { categories } from '../data/site';
import { getProjects, isOnWorkbench } from '../lib/projects';
const projects = await getProjects();
const selected = projects.filter((p) => p.data.featured && !isOnWorkbench(p));
const artwork = projects.filter(
  (p) => p.data.categories.includes('3d') && p.data.status === 'complete',
);
const developing = projects.filter(isOnWorkbench).slice(0, 4);
---

<Base>
  <section class="cinema-hero" aria-labelledby="intro-heading">
    <div class="hero-visual" aria-hidden="true">
      <img
        class="cinema-backdrop"
        src="/media/renders/black-hole.webp"
        alt="Sam’s black-hole artwork, a luminous violet disc against a field of stars"
        width="1920"
        height="1080"
        fetchpriority="high"
      />
      <div class="cinema-shade" aria-hidden="true"></div>
    </div>
    <div class="shell cinema-content">
      <p class="eyebrow">
        Film <span>·</span> Digital art <span>·</span> Design <span>·</span>{' '}
        Interactive
      </p>
      <h1 id="intro-heading">Sam Wright</h1>
      <p class="hero-subtitle">Stories. Worlds. Things that work.</p>
      <p class="hero-description">
        Digital artist, indie developer and filmmaker.
        <br />
        Making ambitious ideas visible.
      </p>
      <div class="hero-actions">
        <a class="button button-primary" href="#selected-heading">
          Explore projects <span aria-hidden="true">↗</span>
        </a>
        <a class="button hero-secondary" href="/about/">
          Behind the work <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
    <div class="shell hero-bottom">
      <span class="hero-location">Independent creative work / Leeds, UK</span>
      <a href="/work/black-hole/" class="hero-credit">
        <span>Featured artwork</span> Black hole{' '}
        <span aria-hidden="true">↗</span>
      </a>
    </div>
  </section>
  <nav class="discipline-strip shell" aria-label="Explore by discipline">
    {categories.map((category, index) => (
      <a href={`/work/?category=${category.id}`}>
        <span class="index-number">0{index + 1}</span>
        {category.label}
        <span aria-hidden="true">↗</span>
      </a>
    ))}
  </nav>
  <section
    class="section shell selected-section"
    aria-labelledby="selected-heading"
  >
    <div class="section-heading compact-heading">
      <div>
        <p class="eyebrow">01 / The portfolio</p>
        <h2 id="selected-heading">Selected work</h2>
      </div>
      <a class="text-link" href="/work/">
        All projects <span aria-hidden="true">→</span>
      </a>
    </div>
    <div
      class="project-grid selected-grid project-rail"
      data-project-rail
      aria-label="Selected projects"
    >
      {selected.map((project, index) => (
        <ProjectCard project={project} index={index} />
      ))}
    </div>
  </section>
  <section class="development-section" aria-labelledby="development-heading">
    <div class="shell">
      <div class="section-heading compact-heading">
        <div>
          <p class="eyebrow">
            <span class="status-dot" aria-hidden="true"></span>02 / On the
            workbench
          </p>
          <h2 id="development-heading">Worlds in the making</h2>
        </div>
        <a class="text-link" href="/development/">
          In development <span aria-hidden="true">→</span>
        </a>
      </div>
      <div
        class="project-grid development-grid project-rail"
        data-project-rail
        aria-label="Projects in development"
      >
        {developing.map((project) => (
          <ProjectCard project={project} compact />
        ))}
      </div>
    </div>
  </section>
  <section
    class="section shell artwork-section"
    aria-labelledby="artwork-heading"
  >
    <div class="section-heading compact-heading">
      <div>
        <h2 id="artwork-heading">Rendered worlds</h2>
      </div>
      <a class="text-link" href="/work/?category=3d">
        All artwork →
      </a>
    </div>
    <div
      class="project-grid project-rail artwork-rail"
      data-project-rail
      aria-label="Digital artwork"
    >
      {artwork.map((project) => (
        <ProjectCard project={project} />
      ))}
    </div>
  </section>
  <section class="section shell about-teaser">
    <div>
      <p class="eyebrow">03 / Behind the work</p>
      <h2>
        Creative thinking.
        <br />
        <em>Create worlds.</em>
      </h2>
    </div>
    <div>
      <p class="large-copy">
        Where a creative idea becomes a practical challenge.
      </p>
      <p>
        Finding the rhythm of a scene, building an atmosphere in 3D or figuring
        out how an app should feel to use. Different tools, and different ways
        to make an idea happen.
      </p>
      <a class="text-link" href="/about/">
        More about me <span aria-hidden="true">↗</span>
      </a>
    </div>
  </section>
</Base>

<script>
  const hero = document.querySelector<HTMLElement>('.cinema-hero')!;
  const title = document.querySelector<HTMLElement>('#intro-heading')!;
  const root = document.documentElement;
  const reduced = matchMedia('(prefers-reduced-motion: reduce)');
  let pending = false;
  function update() {
    const height = hero.offsetHeight;
    const scroll = Math.max(0, -hero.getBoundingClientRect().top);
    const progress = Math.min(1, scroll / Math.max(1, height * 0.85));
    const titleProgress = Math.min(
      1,
      Math.max(0, (100 - title.getBoundingClientRect().top) / 100),
    );
    root.style.setProperty(
      '--hero-opacity',
      String(reduced.matches ? 1 : 1 - progress),
    );
    root.style.setProperty(
      '--title-opacity',
      String(reduced.matches ? 1 : 1 - titleProgress),
    );
    root.style.setProperty(
      '--brand-opacity',
      String(reduced.matches ? 1 : titleProgress),
    );
    root.classList.toggle('hero-scrolled', scroll > 50);
    root.classList.toggle('hero-past', scroll >= height);
    pending = false;
  }
  const requestUpdate = () => {
    if (!pending) {
      pending = true;
      requestAnimationFrame(update);
    }
  };
  root.classList.add('scroll-enhanced');
  addEventListener('scroll', requestUpdate, { passive: true });
  addEventListener('resize', requestUpdate, { passive: true });
  reduced.addEventListener('change', requestUpdate);
  new ResizeObserver(requestUpdate).observe(hero);
  update();
</script>
