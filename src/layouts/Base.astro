---
import { site } from '../data/site';
import '@fontsource-variable/manrope';
import '@fontsource-variable/dm-sans';
import '../styles/global.css';
interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
}
const {
  title,
  description = site.description,
  image = '/images/BlackHole2.png',
  noindex = false,
} = Astro.props;
const pageTitle = title
  ? `${title} — ${site.name}`
  : `${site.name} — Film, 3D & interactive work`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
const path = Astro.url.pathname;
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#151713" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    {noindex && <meta name="robots" content="noindex" />}
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <header class="site-header shell">
      <a href="/" class="wordmark" aria-label="Sam Wright home">
        <span class="mark" aria-hidden="true">
          w.
        </span>{' '}
        Sam Wright<span class="wordmark-note"> / creative portfolio</span>
      </a>
      <nav class="main-nav" aria-label="Main navigation">
        <a
          href="/work/"
          aria-current={path.startsWith('/work/') ? 'page' : undefined}
        >
          Work
        </a>
        <a
          href="/development/"
          aria-current={path.startsWith('/development/') ? 'page' : undefined}
        >
          In progress
        </a>
        <a
          href="/about/"
          aria-current={path.startsWith('/about/') ? 'page' : undefined}
        >
          About
        </a>
        <a class="nav-contact" href="#contact">
          Get in touch <span aria-hidden="true">↗</span>
        </a>
      </nav>
    </header>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <footer id="contact" class="site-footer">
      <div class="shell">
        <div class="footer-top">
          <div>
            <p class="eyebrow">Have something in mind?</p>
            <h2>
              Good work starts
              <br />
              with a conversation.
            </h2>
          </div>
          <a class="contact-link" href={`mailto:${site.email}`}>
            Email me <span aria-hidden="true">↗</span>
          </a>
        </div>
        <div class="footer-bottom">
          <p>
            © {new Date().getFullYear()} Sam Wright <span>·</span> Wright Games
          </p>
          <div class="social-links">
            {site.socials.map((link) => (
              <a href={link.href} target="_blank" rel="noopener noreferrer">
                {link.label}
                <span class="sr-only"> (opens in a new tab)</span> ↗
              </a>
            ))}
          </div>
          <a href="#main">Back to top ↑</a>
        </div>
      </div>
    </footer>
  </body>
</html>
