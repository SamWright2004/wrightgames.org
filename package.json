{
  "name": "sam-wright-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare:assets": "node scripts/prepare-assets.mjs",
    "predev": "npm run prepare:assets",
    "dev": "astro dev",
    "prebuild": "npm run prepare:assets",
    "build": "astro build && node scripts/finalize-build.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "test": "node --test tests/*.test.mjs",
    "verify": "npm run check && npm run build && npm test",
    "new:project": "node scripts/new-project.mjs",
    "format": "prettier --write src scripts tests docs README.md astro.config.mjs"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "astro": "7.3.8"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.1",
    "typescript": "^5.9.3"
  }
}
